# Public build configuration only. Values are deliberately empty: builds fail closed.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only, for Vercel keep-alive and local provisioning. Never PUBLIC_*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CRON_SECRET=
# Set locally when running provision:owner after the first Google sign-in.
CAREER_OWNER_ID=
CAREER_OWNER_EMAIL=
