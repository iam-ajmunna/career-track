{
  "name": "career-track",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check:keys": "node scripts/check-legacy-contract.mjs",
    "provision:owner": "node --env-file-if-exists=.env scripts/provision-owner.mjs",
    "test:browser": "node tests/browser-v3.mjs",
    "check:data": "node scripts/check-normalized-data.mjs && node scripts/check-v3-data.mjs",
    "research:check": "node scripts/research/source-review.mjs",
    "check:ui": "node scripts/check-ui-bindings.mjs",
    "test:browser:v4": "node tests/browser-v4.mjs",
    "check:privacy": "node scripts/check-v4-privacy.mjs",
    "check:ui:v4": "node scripts/check-v4-ui.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.28.2"
  }
}
